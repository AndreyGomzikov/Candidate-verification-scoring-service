# Telegram
BOT_TOKEN=123456:replace_me
TARGET_CHAT_ID=-1001234567890
ADMIN_CHAT_ID=-1009876543210
# Optional. If empty, only administrators/owner of ADMIN_CHAT_ID can press decision buttons.
ADMIN_USER_IDS=

# DB. SQLite is enough for a single bot instance.
DATABASE_URL=sqlite+aiosqlite:///./data/gatekeeper.db
# PostgreSQL example:
# DATABASE_URL=postgresql+asyncpg://gatekeeper:password@db:5432/gatekeeper

# OpenAI-compatible LLM API
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=replace_me
LLM_MODEL=replace_with_your_model
LLM_TIMEOUT_SECONDS=35

# Conservative auto-reject policy
AUTO_REJECT_SPAM_SCORE=85
AUTO_REJECT_CORE_SCORE_MAX=15
AUTO_REJECT_MIN_AI_CONFIDENCE=80
MAX_ANSWER_LENGTH=2500

# Abuse / stale-request protection
INTERVIEW_TIMEOUT_MINUTES=30
REAPPLICATION_COOLDOWN_MINUTES=60
MAINTENANCE_INTERVAL_SECONDS=60
