# DO NOT put real tokens in archives or chats. Fill this file ON THE SERVER.
# Generate with: openssl rand -hex 24 (48 chars, safe for DATABASE_URL).
POSTGRES_PASSWORD=CHANGE_TO_RANDOM_48_HEX_CHARACTERS

BOT_TOKEN=REPLACE_WITH_NEW_TELEGRAM_BOT_TOKEN
TARGET_CHAT_ID=REPLACE_WITH_TEST_TARGET_CHAT_ID
ADMIN_CHAT_ID=REPLACE_WITH_TEST_ADMIN_CHAT_ID
ADMIN_USER_IDS=

# DATABASE_URL is composed by docker-compose.yml (never set old SQLite URL here).
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=REPLACE_WITH_NEW_DEEPSEEK_KEY
LLM_MODEL=deepseek-v4-pro
LLM_TIMEOUT_SECONDS=35

AUTO_REJECT_SPAM_SCORE=85
AUTO_REJECT_CORE_SCORE_MAX=15
AUTO_REJECT_MIN_AI_CONFIDENCE=80
MAX_ANSWER_LENGTH=2500
INTERVIEW_TIMEOUT_MINUTES=30
REAPPLICATION_COOLDOWN_MINUTES=60
MAINTENANCE_INTERVAL_SECONDS=60
